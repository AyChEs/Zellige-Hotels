<Rive version="1" kind="fragment">
    <!-- Logotipo animado de Zellige Hotels (docs/MARCA.md §4 y §13).
         Artboard de 64 x 64 = la retícula del símbolo. La tesela (cuadrado de radio 14 con la puerta
         y la clave recortadas) es siempre la del símbolo; la animación dibuja el borde del arco con
         un trazo y enciende la clave. El tiempo lo manda el número "progreso" (0 a 1) del view model.
         Los colores "tesela" y "luz" también son del view model: el pie los cambia sobre fondo oscuro.
         Sin scripts. -->

    <Artboard defaultStateMachineId="0:7" viewModelId="0:40" styleId="0:5" width="64" height="64" name="Logotipo" id="0:2">
        <LayoutComponentStyle name="Artboard Style" id="0:5"/>

        <NestedArtboard artboardId="0:20" x="0" y="0" name="Cuerpo" id="0:3">
            <NestedRemapAnimation animationId="0:30" name="Tiempo">
                <DataBindContext sourcePathIds="0:40-0:41" propertyKey="202"/>
            </NestedRemapAnimation>
        </NestedArtboard>

        <StateMachine name="Estado" id="0:7">
            <StateMachineLayer name="Capa" id="0:8">
                <AnyState x="200" y="-120"/>
                <ExitState x="400" y="-120"/>
                <EntryState/>
            </StateMachineLayer>
        </StateMachine>
    </Artboard>

    <Artboard isComponent="true" x="120" y="0" styleId="0:25" width="64" height="64" name="Cuerpo" id="0:20">
        <LayoutComponentStyle name="Cuerpo Style" id="0:25"/>

        <!-- Halo de la clave: un rombo fino que se abre y se apaga. -->
        <Shape x="32" y="7.8" opacity="0" name="Halo" id="0:21">
            <PointsPath isClosed="true" name="Rombo">
                <StraightVertex x="0" y="-3.8"/>
                <StraightVertex x="3.8" y="0"/>
                <StraightVertex x="0" y="3.8"/>
                <StraightVertex x="-3.8" y="0"/>
            </PointsPath>
            <Stroke thickness="0.7" join="round" name="Trazo">
                <SolidColor colorValue="FF8B2E3C" name="Color">
                    <DataBindContext sourcePathIds="0:40-0:43" propertyKey="37"/>
                </SolidColor>
            </Stroke>
        </Shape>

        <!-- La clave encendida (un poco mayor que el hueco, para no dejar costura). -->
        <Shape x="32" y="7.8" scaleX="0" scaleY="0" opacity="0" name="Luz" id="0:22">
            <PointsPath isClosed="true" name="Rombo">
                <StraightVertex x="0" y="-4.1"/>
                <StraightVertex x="4.1" y="0"/>
                <StraightVertex x="0" y="4.1"/>
                <StraightVertex x="-4.1" y="0"/>
            </PointsPath>
            <Fill name="Relleno">
                <SolidColor colorValue="FF8B2E3C" name="Color">
                    <DataBindContext sourcePathIds="0:40-0:43" propertyKey="37"/>
                </SolidColor>
            </Fill>
        </Shape>

        <!-- El borde del arco: un trazo que lo recorre de pie a pie. -->
        <Shape opacity="0" name="Borde" id="0:23">
            <PointsPath name="Arco">
                <StraightVertex x="18.6" y="64"/>
                <CubicDetachedVertex x="18.6" y="36.741" inRotation="1.1047" inDistance="0" outRotation="-2.0369" outDistance="5.2052"/>
                <CubicDetachedVertex x="19.2306" y="22.1296" inRotation="2.1231" inDistance="5.2052" outRotation="-1.0184" outDistance="5.2052"/>
                <CubicDetachedVertex x="32" y="15" inRotation="3.1416" inDistance="5.2052" outRotation="0" outDistance="5.2052"/>
                <CubicDetachedVertex x="44.7694" y="22.1296" inRotation="4.16" inDistance="5.2052" outRotation="1.0184" outDistance="5.2052"/>
                <CubicDetachedVertex x="45.4" y="36.741" inRotation="5.1785" inDistance="5.2052" outRotation="2.0369" outDistance="0"/>
                <StraightVertex x="45.4" y="64"/>
            </PointsPath>
            <Stroke thickness="1.3" cap="round" join="round" name="Trazo">
                <SolidColor colorValue="FF8B2E3C" name="Color">
                    <DataBindContext sourcePathIds="0:40-0:43" propertyKey="37"/>
                </SolidColor>
                <TrimPath start="0" end="0" id="0:24" name="Recorte"/>
            </Stroke>
        </Shape>

        <!-- La tesela: cuadrado de 64 u con radio 14, la puerta y la clave recortadas (regla par-impar). -->
        <Shape name="Tesela" id="0:26">
            <Rectangle width="64" height="64" originX="0" originY="0" cornerRadiusTL="14" name="Cuadrado"/>
            <PointsPath isClosed="true" name="Puerta">
                <StraightVertex x="18.6" y="64"/>
                <CubicDetachedVertex x="18.6" y="36.741" inRotation="1.1047" inDistance="0" outRotation="-2.0369" outDistance="5.2052"/>
                <CubicDetachedVertex x="19.2306" y="22.1296" inRotation="2.1231" inDistance="5.2052" outRotation="-1.0184" outDistance="5.2052"/>
                <CubicDetachedVertex x="32" y="15" inRotation="3.1416" inDistance="5.2052" outRotation="0" outDistance="5.2052"/>
                <CubicDetachedVertex x="44.7694" y="22.1296" inRotation="4.16" inDistance="5.2052" outRotation="1.0184" outDistance="5.2052"/>
                <CubicDetachedVertex x="45.4" y="36.741" inRotation="5.1785" inDistance="5.2052" outRotation="2.0369" outDistance="0"/>
                <StraightVertex x="45.4" y="64"/>
            </PointsPath>
            <PointsPath isClosed="true" name="Clave">
                <StraightVertex x="32" y="4"/>
                <StraightVertex x="35.8" y="7.8"/>
                <StraightVertex x="32" y="11.6"/>
                <StraightVertex x="28.2" y="7.8"/>
            </PointsPath>
            <Fill fillRule="evenOdd" name="Relleno">
                <SolidColor colorValue="FF1E5B46" name="Color">
                    <DataBindContext sourcePathIds="0:40-0:42" propertyKey="37"/>
                </SolidColor>
            </Fill>
        </Shape>

        <LinearAnimation loopValue="oneShot" duration="108" name="Dibuja" id="0:30">
            <KeyedObject objectId="0:23">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="3" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="58" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="92" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:24">
                <KeyedProperty property="end">
                    <KeyFrameDouble value="0" frame="0" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.45" y1="0" x2="0.35" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="58" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:22">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="52" interpolationType="linear"/>
                    <KeyFrameDouble value="1" frame="60" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="0" frame="52" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="84" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="0" frame="52" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="1" frame="84" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
            <KeyedObject objectId="0:21">
                <KeyedProperty property="opacity">
                    <KeyFrameDouble value="0" frame="0" interpolationType="hold"/>
                    <KeyFrameDouble value="0" frame="56" interpolationType="linear"/>
                    <KeyFrameDouble value="0.7" frame="64" interpolationType="linear"/>
                    <KeyFrameDouble value="0" frame="108" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleX">
                    <KeyFrameDouble value="1" frame="56" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="2.1" frame="108" interpolationType="linear"/>
                </KeyedProperty>
                <KeyedProperty property="scaleY">
                    <KeyFrameDouble value="1" frame="56" interpolationType="cubic">
                        <CubicEaseInterpolator x1="0.22" y1="1" x2="0.36" y2="1"/>
                    </KeyFrameDouble>
                    <KeyFrameDouble value="2.1" frame="108" interpolationType="linear"/>
                </KeyedProperty>
            </KeyedObject>
        </LinearAnimation>
    </Artboard>

    <ComponentAsset artboardId="0:20" name="Cuerpo"/>

    <ViewModel defaultInstanceId="0:44" name="Logotipo" id="0:40">
        <ViewModelPropertyNumber name="progreso" id="0:41"/>
        <ViewModelPropertyColor name="tesela" id="0:42"/>
        <ViewModelPropertyColor name="luz" id="0:43"/>
        <ViewModelInstance exports="true" name="Reposo" id="0:44">
            <ViewModelInstanceNumber propertyValue="1" viewModelPropertyId="0:41"/>
            <ViewModelInstanceColor propertyValue="FF1E5B46" viewModelPropertyId="0:42"/>
            <ViewModelInstanceColor propertyValue="FF8B2E3C" viewModelPropertyId="0:43"/>
        </ViewModelInstance>
    </ViewModel>
</Rive>
